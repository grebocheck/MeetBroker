NODE_ENV=development
APP_MODE=DEMO
APP_ORIGIN=http://localhost:8080
API_PORT=3000
DATABASE_URL=postgres://meetbroker:meetbroker@postgres:5432/meetbroker
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=meetbroker_session
EMAIL_VERIFICATION_REQUIRED=false
OFFICE_TIMEZONE=Europe/Kyiv
UPLOAD_DIR=/app/storage/uploads
MAX_AVATAR_BYTES=12582912

POSTGRES_DB=meetbroker
POSTGRES_USER=meetbroker
POSTGRES_PASSWORD=meetbroker
SEED_DEMO_DATA=true

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MeetBroker <notifications@example.com>

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=change-me
TELEGRAM_UPDATE_MODE=POLLING

NOTIFY_BEFORE_MINUTES=10
VITE_API_BASE_URL=/api

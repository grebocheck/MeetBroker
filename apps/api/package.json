{
  "name": "@meetbroker/api",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node src/database/migrate.mjs",
    "db:migrate:prod": "node src/database/migrate.mjs",
    "db:migrate:status": "tsx src/database/migration-status.ts",
    "db:migrate:status:prod": "node dist/database/migration-status.js",
    "db:migrate:create": "node-pg-migrate create --migration-file-language sql --migration-filename-format index --migrations-dir src/database/migrations",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:prod": "node dist/database/seed.js",
    "admin:cli": "tsx src/database/admin-cli.ts",
    "admin:cli:prod": "node dist/database/admin-cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "10.0.10",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
